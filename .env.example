# Copy this file to .env and fill in your Alpaca paper trading keys.
# Get them from alpaca.markets -> make sure you're in Paper Trading mode -> API Keys panel.
# Never commit .env — it holds real credentials.

ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
PORT=8787

# Optional: enables the "Get AI Feedback" button in Strategy Backtest and the
# Strategy Tester. Get a key from console.anthropic.com (pay-per-use billing —
# a single feedback request costs a fraction of a cent). Leave blank to skip.
ANTHROPIC_API_KEY=
